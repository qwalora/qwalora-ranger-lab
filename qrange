#!/usr/bin/env bash
# =============================================================================
# qrange - the one-click control for the Qwalora Ranger lab.
#
#   ./qrange up [board]      bring the range up (loopback-only), print URLs
#   ./qrange down            tear it down and wipe volumes
#   ./qrange exploit <board> run the board's exploit harness
#   ./qrange check <board>   grade one board (no Docker needed)
#   ./qrange status          grade everything -> evidence/PROGRESS.md
#   ./qrange pack            build an offline bundle (images + repo) as a zip
#   ./qrange pin             resolve image digests into the compose/Dockerfiles
#   ./qrange doctor          preflight: check tooling and ports
#
# check/status run with just python3, so grading works on a laptop or in CI.
# up/exploit/pack/pin need Docker. Nothing ever leaves loopback.
# =============================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

O=$'\033[38;5;208m'; P=$'\033[38;5;99m'; G=$'\033[38;5;42m'
R=$'\033[38;5;203m'; D=$'\033[2m'; B=$'\033[1m'; X=$'\033[0m'
say()  { printf '%s%s%s %s/%s %s\n' "$O" "Qwalora Ranger" "$X" "$D" "$X" "$*"; }
die()  { printf '%s%s%s %s\n' "$R" "x" "$X" "$*" >&2; exit 1; }
ok()   { printf '%s%s%s %s\n' "$G" "ok" "$X" "$*"; }

compose() {
  if docker compose version >/dev/null 2>&1; then docker compose "$@";
  elif command -v docker-compose >/dev/null 2>&1; then docker-compose "$@";
  else die "Docker Compose v2 not found. Install Docker Desktop or the compose plugin."; fi
}

need_docker() { command -v docker >/dev/null 2>&1 || die "Docker is not installed or not on PATH."; }

gen_secret() {
  local f=lab/soc/grafana/admin_password
  if [ ! -s "$f" ]; then
    mkdir -p "$(dirname "$f")"
    (openssl rand -hex 16 2>/dev/null || head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n') > "$f"
    ok "generated Grafana admin password (lab/soc/grafana/admin_password, gitignored)"
  fi
}

cmd_doctor() {
  say "doctor"
  command -v python3 >/dev/null 2>&1 && ok "python3 $(python3 -V 2>&1 | awk '{print $2}')" || die "python3 missing (needed for grading)"
  python3 -c "import yaml" 2>/dev/null && ok "pyyaml present" || echo "${R}note${X} pip install pyyaml (needed for grading)"
  if command -v docker >/dev/null 2>&1; then ok "docker present"; else echo "${D}info${X} docker absent (check/status still work)"; fi
  for port in 7443 3000 1514; do
    if command -v lsof >/dev/null 2>&1 && lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
      echo "${R}busy${X} 127.0.0.1:$port is in use"; else ok "127.0.0.1:$port free"; fi
  done
}

cmd_up() {
  need_docker; gen_secret
  local board="${1:-board2}"
  say "up ($board)"
  grep -q "REPLACE_WITH_PINNED_DIGEST" docker-compose.yml 2>/dev/null && \
    echo "${R}note${X} images not pinned yet - run './qrange pin' for reproducible, verified builds."
  compose up -d --build target-webapi attacker suricata
  ok "range is up"
  printf '  %starget API%s   http://127.0.0.1:7443   %s(exploit this)%s\n' "$B" "$X" "$D" "$X"
  printf '  %sGrafana%s      http://127.0.0.1:3000    %s(start with: ./qrange up-soc)%s\n' "$B" "$X" "$D" "$X"
  printf '  %sattacker%s     docker exec -it qwalora-range-attacker-1 sh\n' "$B" "$X"
  echo "  ${D}grade with: ./qrange check $board${X}"
}

cmd_up_soc() { need_docker; gen_secret; say "up-soc"; compose up -d wazuh grafana; ok "SOC stack up (Grafana http://127.0.0.1:3000)"; }

cmd_down()  { need_docker; say "down"; compose down -v --remove-orphans; ok "range down, volumes wiped"; }

cmd_exploit() {
  local board="${1:-board2}"
  say "exploit ($board)"
  local harness="lab/attacker/toolbox/exploit_${board#board}.py"
  [ -f "$harness" ] || harness="lab/attacker/toolbox/exploit_bola.py"
  TARGET="${TARGET:-http://127.0.0.1:7443}" python3 "$harness" || true
}

cmd_check()  { say "check"; python3 scripts/validate.py "${1:?usage: qrange check <board>}"; }
cmd_status() { python3 scripts/progress.py; }

cmd_pin() {
  need_docker; say "pin"
  python3 scripts/pin_images.py || die "pinning failed"
  ok "image digests written. Commit the changes for reproducible builds."
}

cmd_pack() {
  need_docker; say "pack"
  local out="qwalora-ranger-offline.zip"
  local tmp; tmp="$(mktemp -d)"
  echo "  saving images (offline bundle)..."
  compose config --images 2>/dev/null | sort -u | while read -r img; do
    [ -n "$img" ] && docker pull -q "$img" >/dev/null 2>&1 || true
  done
  docker save $(compose config --images 2>/dev/null | sort -u | tr '\n' ' ') -o "$tmp/images.tar" 2>/dev/null || \
    echo "${R}note${X} some images could not be saved; run './qrange up' once first."
  git archive --format=zip -o "$tmp/repo.zip" HEAD 2>/dev/null || \
    (cd "$ROOT" && zip -qr "$tmp/repo.zip" . -x '.git/*')
  ( cd "$tmp" && zip -q "$ROOT/$out" images.tar repo.zip )
  rm -rf "$tmp"
  ok "wrote $out (load with: docker load -i images.tar, then unzip repo.zip)"
}

main() {
  local sub="${1:-help}"; shift || true
  case "$sub" in
    up)      cmd_up "$@";;
    up-soc)  cmd_up_soc "$@";;
    down)    cmd_down "$@";;
    exploit) cmd_exploit "$@";;
    check)   cmd_check "$@";;
    status)  cmd_status "$@";;
    pin)     cmd_pin "$@";;
    pack)    cmd_pack "$@";;
    doctor)  cmd_doctor "$@";;
    help|-h|--help)
      sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//';;
    *) die "unknown command: $sub (try './qrange help')";;
  esac
}
main "$@"
